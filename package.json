{
  "name": "deckforge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "10.30.2"
  },
  "scripts": {
    "dev": "pnpm db:generate && turbo run dev",
    "dev:api": "pnpm db:generate && pnpm --filter \"@deckforge/api^...\" -r build && pnpm --filter @deckforge/api dev",
    "dev:mobile": "pnpm build:packages && pnpm --filter @deckforge/mobile dev",
    "dev:web": "pnpm build:packages && pnpm --filter @deckforge/mobile web",
    "dev:admin": "pnpm build:packages && pnpm --filter @deckforge/admin dev",
    "dev:jobs": "pnpm --filter @deckforge/jobs dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "build": "pnpm db:generate && turbo run build",
    "build:packages": "pnpm db:generate && pnpm --filter \"./packages/*\" -r build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm db:generate && turbo run typecheck && tsc -p tsconfig.tests.json",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "setup:local": "node scripts/setup.mjs && pnpm db:generate",
    "ci:quality": "pnpm check && pnpm build",
    "ci:audit": "pnpm audit --audit-level=high",
    "ci:database": "node scripts/ci-database.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "node scripts/database-reset.mjs",
    "db:test": "node scripts/ci-database.mjs",
    "catalog:export": "pnpm build:packages && tsx scripts/export-card-art.mts && prettier --write packages/card-domain/src/development-catalog.ts assets/foundation/manifest.json",
    "test:poker:exhaustive": "pnpm build:packages && vitest run packages/game-poker/src/evaluator.exhaustive.test.ts",
    "test:poker:seven": "pnpm build:packages && vitest run packages/game-poker/src/seven.test.ts",
    "test:poker:harness": "pnpm build:packages && tsx scripts/poker-harness.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
