{
  "expo": {
    "name": "DeckForge Dev",
    "slug": "deckforge-dev",
    "version": "0.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "com.deckforge.dev",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Optional foreground step reads for activity review. Games and accessible quests do not require health access."
      }
    },
    "android": {
      "package": "com.deckforge.dev"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
