# Public, bundled into the app: never place secrets in EXPO_PUBLIC_*.
# Android emulator: http://10.0.2.2:3001; device: your computer LAN address.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Optional public managed-provider configuration; no service-role or secret key.
# Leave both blank for the artwork preview only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
