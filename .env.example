# Local-only sample values. Never reuse them in deployed environments.
POSTGRES_USER=deckforge
POSTGRES_PASSWORD=deckforge_local_only
POSTGRES_DB=deckforge
POSTGRES_PORT=5432
REDIS_PORT=6379

# Prisma CLI uses this root value; keep it in sync if Compose credentials/ports change.
DATABASE_URL=postgresql://deckforge:deckforge_local_only@localhost:5432/deckforge
