import { mkdir, writeFile } from 'node:fs/promises';
import { createHash } from 'node:crypto';
import { canonicalFaces } from '../packages/game-core/src/index';
import {
  renderCardFaceSvg,
  renderCardBackSvg,
} from '../packages/ui/src/card-art';

const version = 1;
const root = new URL('../', import.meta.url);
const assetId = (number: number) =>
  '22222222-2222-4222-8222-' +
  String(version * 1000 + number).padStart(12, '0');
const templateId = (number: number) =>
  '33333333-3333-4333-8333-' +
  String(version * 1000 + number).padStart(12, '0');
const entries = [
  ...canonicalFaces.map((face, i) => ({
    id: assetId(i + 1),
    faceId: face.id as string | null,
    kind: 'FRONT' as const,
    key: 'foundation/v1/front/' + face.id + '.svg',
    content: renderCardFaceSvg(face.id),
  })),
  {
    id: assetId(53),
    faceId: null,
    kind: 'BACK' as const,
    key: 'foundation/v1/back.svg',
    content: renderCardBackSvg(),
  },
];
for (const entry of entries) {
  const file = new URL('assets/' + entry.key, root);
  await mkdir(new URL('./', file), { recursive: true });
  await writeFile(file, entry.content + '\n');
}
const manifest = {
  version,
  seriesId: '11111111-1111-4111-8111-111111111111',
  slug: 'deckforge-foundation-sample',
  displayName: 'Foundation Study',
  status: 'DRAFT',
  assets: entries.map(({ content, ...entry }) => ({
    ...entry,
    mimeType: 'image/svg+xml',
    sha256: createHash('sha256')
      .update(content + '\n')
      .digest('hex'),
    width: 240,
    height: 336,
    rights: {
      basis: 'ORIGINAL_CODE',
      holder: 'PROJECT_SOURCE_CONTRIBUTORS',
      sourceRef: 'packages/ui/src/card-art.ts',
      useScope: 'INTERNAL_PREVIEW',
    },
  })),
  templates: canonicalFaces.map((face, i) => ({
    id: templateId(i + 1),
    faceId: face.id,
    frontAssetId: assetId(i + 1),
    backAssetId: assetId(53),
    rarity: 'COMMON',
    playStyleFamily: 'foundation-study-v1',
  })),
};
await writeFile(
  new URL('assets/foundation/manifest.json', root),
  JSON.stringify(manifest, null, 2) + '\n',
);
await writeFile(
  new URL('packages/card-domain/src/development-catalog.ts', root),
  '// Generated by pnpm catalog:export. Draft-only source/art provenance; no publication approval.\nexport const developmentCatalog = ' +
    JSON.stringify(manifest, null, 2) +
    ' as const;\n',
);
console.info(
  'Exported 52 original faces, one back and draft manifest; no publishing or grants.',
);
