HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
# Reserved for B004; B001 liveness does not connect to either service.
DATABASE_URL=postgresql://deckforge:deckforge_local_only@localhost:5432/deckforge
REDIS_URL=redis://localhost:6379

# Optional development Supabase Auth adapter. Leave all unset for health-only startup.
# Use a development project with asymmetric signing keys; these URLs are public configuration.
# AUTH_ISSUER=https://your-development-project.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_JWKS_URL=https://your-development-project.supabase.co/auth/v1/.well-known/jwks.json
