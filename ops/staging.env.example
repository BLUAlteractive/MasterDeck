# Template only. Use a separate staging identity/database/key namespace and a protected secret manager.
NODE_ENV=production
DEPLOYMENT_ENV=staging
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=https://admin.staging.example.invalid
# Fill through protected deployment configuration; never copy development passwords.
DATABASE_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=
# DATABASE_URL must use PostgreSQL sslmode=verify-full and the approved CA configuration.
# Reviewed feature policies are server bootstrap objects, not arbitrary env/public mobile flags.
