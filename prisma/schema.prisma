  @@index([status, nextAttemptAt])
}

model BillingAcknowledgement {
  purchaseId    String           @id @db.Uuid
  status        String           @default("PENDING")
  attempts      Int              @default(0)
  nextAttemptAt DateTime         @default(now()) @db.Timestamptz(3)
