generator client {
  provider     = "prisma-client"
  output       = "../packages/database/src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ArtAssetKind {
  FRONT
  BACK
}

enum AssetUseScope {
  INTERNAL_PREVIEW
  COMMERCIAL
}

enum UserRole {
  PLAYER
  ADMIN
}

enum FaceSuit {
  CLUBS
  DIAMONDS
  HEARTS
  SPADES
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CardRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum CardBranch {
  BLUE
  RED
}

enum CardStatus {
  OWNED
  LOCKED
  CONSUMED
  REVOKED
}

enum OwnershipAction {
  MINT
  GRANT
  FUSION_CONSUME
  FUSION_CREATE
  PRESS_EVOLVE
  LOCK
  UNLOCK
  REVOKE
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  status            UserStatus         @default(ACTIVE)
  role              UserRole           @default(PLAYER)
  isGuest           Boolean            @default(true)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  identities        ExternalIdentity[]
  cards             CardInstance[]
  events            OwnershipEvent[]
  operations        OperationRecord[]
  authAudit         AuthAudit[]
  deletionRequest   DeletionRequest?
  starterGrant      StarterGrant?
  loadout           Loadout?
  collectionManager CollectionManager?
}

model ExternalIdentity {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  issuer    String
  subject   String
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions  AuthSession[]

  @@unique([issuer, subject])
  @@index([userId])
}

model FaceDefinition {
  id        String         @id
  rank      Int
  suit      FaceSuit
  templates CardTemplate[]
  artAssets DesignAsset[]

  @@unique([rank, suit])
}

model CardSeries {
  id              String         @id @default(uuid()) @db.Uuid
  slug            String         @unique
  displayName     String
  manifestVersion Int            @default(1)
  rightsOwner     String
  status          CatalogStatus  @default(DRAFT)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  templates       CardTemplate[]
  starterEligible Boolean        @default(false)
  starterGrants   StarterGrant[]
}

model CardTemplate {
  id              String         @id @default(uuid()) @db.Uuid
  seriesId        String         @db.Uuid
  faceId          String
  version         Int            @default(1)
  playStyleFamily String
  rarity          CardRarity     @default(COMMON)
  series          CardSeries     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  face            FaceDefinition @relation(fields: [faceId], references: [id], onDelete: Restrict)
  frontAssetId    String?        @db.Uuid
  frontKind       ArtAssetKind   @default(FRONT)
  backAssetId     String?        @db.Uuid
  backKind        ArtAssetKind   @default(BACK)
  frontAsset      DesignAsset?   @relation("TemplateFront", fields: [frontAssetId, faceId, frontKind], references: [id, faceId, kind], onDelete: Restrict)
  backAsset       DesignAsset?   @relation("TemplateBack", fields: [backAssetId, backKind], references: [id, kind], onDelete: Restrict)
  instances       CardInstance[]

  @@unique([seriesId, faceId, version])
  @@unique([id, seriesId, faceId])
}

model CardInstance {
  id             String           @id @default(uuid()) @db.Uuid
  ownerId        String           @db.Uuid
  templateId     String           @db.Uuid
  seriesId       String           @db.Uuid
  faceId         String
  status         CardStatus       @default(OWNED)
  level          Int              @default(1)
  branch         CardBranch       @default(BLUE)
  rarity         CardRarity       @default(COMMON)
  editionSerial  Int?
  stateVersion   Int              @default(1)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  template       CardTemplate     @relation(fields: [templateId, seriesId, faceId], references: [id, seriesId, faceId], onDelete: Restrict)
  events         OwnershipEvent[]
  originEventId  String?          @db.Uuid
  originEvent    OwnershipEvent?  @relation("CardOrigin", fields: [originEventId, id], references: [id, instanceId], onDelete: Restrict, onUpdate: NoAction)
  lockToken      String?          @db.Uuid
  lockReason     String?
  starterGrantId String?          @db.Uuid
  starterGrant   StarterGrant?    @relation(fields: [starterGrantId], references: [id], onDelete: Restrict)

  favorites    CardFavorite[]
  loadoutCards LoadoutCard[]
  managerSlots CollectionManagerSlot[]

  @@unique([id, ownerId, faceId])
  @@unique([id, ownerId])
  @@unique([starterGrantId, faceId])
  @@unique([seriesId, editionSerial])
  @@index([ownerId, status, faceId])
}

model OwnershipEvent {
  id           String          @id @default(uuid()) @db.Uuid
  instanceId   String          @db.Uuid
  actorUserId  String?         @db.Uuid
  action       OwnershipAction
  sourceKey    String          @unique
  reason       String
  stateVersion Int
  snapshot     Json
  recordedAt   DateTime        @default(now()) @db.Timestamptz(3)
  instance     CardInstance    @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  actor        User?           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  operatorId   String?
  origins      CardInstance[]  @relation("CardOrigin")

  @@unique([id, instanceId])
  @@unique([instanceId, stateVersion])
  @@index([instanceId, stateVersion, id])
  @@index([instanceId, recordedAt])
}

// Foundation only: feature services own request hashes, replay and expiry semantics.
model OperationRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  operation   String
  key         String
  requestHash String
  result      Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
}

model AuthSession {
  id                String           @id @default(uuid()) @db.Uuid
  identityId        String           @db.Uuid
  providerSessionId String           @db.Uuid
  revokedAt         DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  identity          ExternalIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@unique([identityId, providerSessionId])
}

model AuthAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  event     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Queue only: B051 supplies provider deletion, retention, export and actual purge.
model DeletionRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model DesignAsset {
  id                String          @id @db.Uuid
  key               String          @unique
  kind              ArtAssetKind
  faceId            String?
  mimeType          String
  sha256            String
  width             Int
  height            Int
  rightsBasis       String
  rightsHolder      String
  sourceRef         String
  useScope          AssetUseScope   @default(INTERNAL_PREVIEW)
  approvalReference String?
  face              FaceDefinition? @relation(fields: [faceId], references: [id], onDelete: Restrict)
  fronts            CardTemplate[]  @relation("TemplateFront")
  backs             CardTemplate[]  @relation("TemplateBack")

  @@unique([id, faceId, kind])
  @@unique([id, kind])
}

// Permanent business-source uniqueness survives retries, logout and inventory changes.
model StarterGrant {
  id              String         @id @db.Uuid
  userId          String         @unique @db.Uuid
  seriesId        String         @db.Uuid
  manifestVersion Int
  result          Json
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  series          CardSeries     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  cards           CardInstance[]
}

model Loadout {
  id      String        @id @db.Uuid
  userId  String        @unique @db.Uuid
  version Int           @default(1)
  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cards   LoadoutCard[]

  @@unique([id, userId, version])
}

model LoadoutCard {
  loadoutId      String       @db.Uuid
  userId         String       @db.Uuid
  loadoutVersion Int
  faceId         String
  instanceId     String       @db.Uuid
  loadout        Loadout      @relation(fields: [loadoutId, userId, loadoutVersion], references: [id, userId, version], onDelete: Restrict, onUpdate: NoAction)
  instance       CardInstance @relation(fields: [instanceId, userId, faceId], references: [id, ownerId, faceId], onDelete: Restrict, onUpdate: Restrict)

  @@id([loadoutId, faceId])
  @@unique([loadoutId, instanceId])
}

model CollectionManager {
  userId  String                  @id @db.Uuid
  version Int                     @default(1)
  user    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  slots   CollectionManagerSlot[]

  @@unique([userId, version])
}

model CollectionManagerSlot {
  userId         String            @db.Uuid
  managerVersion Int
  slot           Int
  instanceId     String            @db.Uuid
  manager        CollectionManager @relation(fields: [userId, managerVersion], references: [userId, version], onDelete: Restrict, onUpdate: NoAction)
  instance       CardInstance      @relation(fields: [instanceId, userId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, slot])
  @@unique([userId, instanceId])
}

// Presentation preference only; does not confer ownership or gameplay eligibility.
model CardFavorite {
  userId     String       @db.Uuid
  instanceId String       @db.Uuid
  favorite   Boolean      @default(false)
  instance   CardInstance @relation(fields: [instanceId, userId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, instanceId])
}
