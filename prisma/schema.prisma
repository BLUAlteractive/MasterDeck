generator client {
  provider     = "prisma-client"
  output       = "../packages/database/src/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ArtAssetKind {
  FRONT
  BACK
}

enum AssetUseScope {
  INTERNAL_PREVIEW
  COMMERCIAL
}

enum UserRole {
  PLAYER
  ADMIN
}

enum FaceSuit {
  CLUBS
  DIAMONDS
  HEARTS
  SPADES
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CardRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum CardBranch {
  BLUE
  RED
}

enum CardStatus {
  OWNED
  LOCKED
  CONSUMED
  REVOKED
}

enum OwnershipAction {
  MINT
  GRANT
  FUSION_CONSUME
  FUSION_CREATE
  PRESS_EVOLVE
  LOCK
  UNLOCK
  REVOKE
}

model User {
  id                    String                      @id @default(uuid()) @db.Uuid
  status                UserStatus                  @default(ACTIVE)
  role                  UserRole                    @default(PLAYER)
  isGuest               Boolean                     @default(true)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(3)
  identities            ExternalIdentity[]
  cards                 CardInstance[]
  events                OwnershipEvent[]
  operations            OperationRecord[]
  authAudit             AuthAudit[]
  deletionRequest       DeletionRequest?
  starterGrant          StarterGrant?
  loadout               Loadout?
  collectionManager     CollectionManager?
  chipAccount           PlayChipAccount?
  gameReservations      GameReservation[]
  lobbySeat             LobbySeat?
  gameParticipants      GameParticipant[]
  gameEvents            GameEvent[]
  spadesSeats           SpadesSeat[]
  spadesEvents          SpadesEvent[]
  spadesReservations    SpadesReservation[]
  tableMessages         TableMessage[]
  fusionPreviews        FusionPreview[]
  fusionJobs            FusionJob[]
  progressEvents        ProgressEvent[]
  progressCounters      ProgressCounter[]
  progressAwards        ProgressAward[]
  restrictedAccounts    RestrictedAccount[]
  accessibleEnrollments AccessibleQuestEnrollment[]
  accessibleFacts       AccessibleQuestFact[]
  cosmeticGrants        CosmeticGrant[]
  billingBinding        BillingBinding?
  tournamentEntries     TournamentEntry[]
  purchases             VerifiedPurchase[]
}

model ExternalIdentity {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  issuer    String
  subject   String
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions  AuthSession[]

  @@unique([issuer, subject])
  @@index([userId])
}

model FaceDefinition {
  id        String         @id
  rank      Int
  suit      FaceSuit
  templates CardTemplate[]
  artAssets DesignAsset[]

  @@unique([rank, suit])
}

model CardSeries {
  id              String         @id @default(uuid()) @db.Uuid
  slug            String         @unique
  displayName     String
  manifestVersion Int            @default(1)
  rightsOwner     String
  status          CatalogStatus  @default(DRAFT)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  templates       CardTemplate[]
  starterEligible Boolean        @default(false)
  starterGrants   StarterGrant[]
}

model CardTemplate {
  id              String         @id @default(uuid()) @db.Uuid
  seriesId        String         @db.Uuid
  faceId          String
  version         Int            @default(1)
  playStyleFamily String
  rarity          CardRarity     @default(COMMON)
  series          CardSeries     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  face            FaceDefinition @relation(fields: [faceId], references: [id], onDelete: Restrict)
  frontAssetId    String?        @db.Uuid
  frontKind       ArtAssetKind   @default(FRONT)
  backAssetId     String?        @db.Uuid
  backKind        ArtAssetKind   @default(BACK)
  frontAsset      DesignAsset?   @relation("TemplateFront", fields: [frontAssetId, faceId, frontKind], references: [id, faceId, kind], onDelete: Restrict)
  backAsset       DesignAsset?   @relation("TemplateBack", fields: [backAssetId, backKind], references: [id, kind], onDelete: Restrict)
  instances       CardInstance[]

  @@unique([seriesId, faceId, version])
  @@unique([id, seriesId, faceId])
}

model CardInstance {
  id             String           @id @default(uuid()) @db.Uuid
  ownerId        String           @db.Uuid
  templateId     String           @db.Uuid
  seriesId       String           @db.Uuid
  faceId         String
  status         CardStatus       @default(OWNED)
  level          Int              @default(1)
  branch         CardBranch       @default(BLUE)
  rarity         CardRarity       @default(COMMON)
  editionSerial  Int?
  stateVersion   Int              @default(1)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  template       CardTemplate     @relation(fields: [templateId, seriesId, faceId], references: [id, seriesId, faceId], onDelete: Restrict)
  events         OwnershipEvent[]
  originEventId  String?          @db.Uuid
  originEvent    OwnershipEvent?  @relation("CardOrigin", fields: [originEventId, id], references: [id, instanceId], onDelete: Restrict, onUpdate: NoAction)
  lockToken      String?          @db.Uuid
  lockReason     String?
  starterGrantId String?          @db.Uuid
  starterGrant   StarterGrant?    @relation(fields: [starterGrantId], references: [id], onDelete: Restrict)

  fusionChild      FusionJob?
  fusionIngredient FusionIngredient?
  favorites        CardFavorite[]
  loadoutCards     LoadoutCard[]
  managerSlots     CollectionManagerSlot[]

  @@unique([id, ownerId, faceId])
  @@unique([id, ownerId])
  @@unique([starterGrantId, faceId])
  @@unique([seriesId, editionSerial])
  @@index([ownerId, status, faceId])
}

model OwnershipEvent {
  id           String          @id @default(uuid()) @db.Uuid
  instanceId   String          @db.Uuid
  actorUserId  String?         @db.Uuid
  action       OwnershipAction
  sourceKey    String          @unique
  reason       String
  stateVersion Int
  snapshot     Json
  recordedAt   DateTime        @default(now()) @db.Timestamptz(3)
  instance     CardInstance    @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  actor        User?           @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  operatorId   String?
  origins      CardInstance[]  @relation("CardOrigin")

  @@unique([id, instanceId])
  @@unique([instanceId, stateVersion])
  @@index([instanceId, stateVersion, id])
  @@index([instanceId, recordedAt])
}

// Foundation only: feature services own request hashes, replay and expiry semantics.
model OperationRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  operation   String
  key         String
  requestHash String
  result      Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
}

model AuthSession {
  id                String           @id @default(uuid()) @db.Uuid
  identityId        String           @db.Uuid
  providerSessionId String           @db.Uuid
  revokedAt         DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  identity          ExternalIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  @@unique([identityId, providerSessionId])
}

model AuthAudit {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  event     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

// Queue only: B051 supplies provider deletion, retention, export and actual purge.
model DeletionRequest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model DesignAsset {
  id                String          @id @db.Uuid
  key               String          @unique
  kind              ArtAssetKind
  faceId            String?
  mimeType          String
  sha256            String
  width             Int
  height            Int
  rightsBasis       String
  rightsHolder      String
  sourceRef         String
  useScope          AssetUseScope   @default(INTERNAL_PREVIEW)
  approvalReference String?
  face              FaceDefinition? @relation(fields: [faceId], references: [id], onDelete: Restrict)
  fronts            CardTemplate[]  @relation("TemplateFront")
  backs             CardTemplate[]  @relation("TemplateBack")

  @@unique([id, faceId, kind])
  @@unique([id, kind])
}

// Permanent business-source uniqueness survives retries, logout and inventory changes.
model StarterGrant {
  id              String         @id @db.Uuid
  userId          String         @unique @db.Uuid
  seriesId        String         @db.Uuid
  manifestVersion Int
  result          Json
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  series          CardSeries     @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  cards           CardInstance[]
}

model Loadout {
  id      String        @id @db.Uuid
  userId  String        @unique @db.Uuid
  version Int           @default(1)
  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cards   LoadoutCard[]

  @@unique([id, userId, version])
}

model LoadoutCard {
  loadoutId      String       @db.Uuid
  userId         String       @db.Uuid
  loadoutVersion Int
  faceId         String
  instanceId     String       @db.Uuid
  loadout        Loadout      @relation(fields: [loadoutId, userId, loadoutVersion], references: [id, userId, version], onDelete: Restrict, onUpdate: NoAction)
  instance       CardInstance @relation(fields: [instanceId, userId, faceId], references: [id, ownerId, faceId], onDelete: Restrict, onUpdate: Restrict)

  @@id([loadoutId, faceId])
  @@unique([loadoutId, instanceId])
}

model CollectionManager {
  userId  String                  @id @db.Uuid
  version Int                     @default(1)
  user    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  slots   CollectionManagerSlot[]

  @@unique([userId, version])
}

model CollectionManagerSlot {
  userId         String            @db.Uuid
  managerVersion Int
  slot           Int
  instanceId     String            @db.Uuid
  manager        CollectionManager @relation(fields: [userId, managerVersion], references: [userId, version], onDelete: Restrict, onUpdate: NoAction)
  instance       CardInstance      @relation(fields: [instanceId, userId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, slot])
  @@unique([userId, instanceId])
}

// Presentation preference only; does not confer ownership or gameplay eligibility.
model CardFavorite {
  userId     String       @db.Uuid
  instanceId String       @db.Uuid
  favorite   Boolean      @default(false)
  instance   CardInstance @relation(fields: [instanceId, userId], references: [id, ownerId], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, instanceId])
}

// Server-private poker aggregate. Never expose JSON snapshots or events directly.
model GameRoom {
  id             String            @id @db.Uuid
  rulesetVersion String
  stateVersion   Int               @default(0)
  status         String
  initial        Json
  snapshot       Json
  commitment     String
  turnTimeoutMs  Int               @default(30000)
  turnDeadline   DateTime?         @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  chipEscrow     PlayChipAccount?
  admission      GameAdmission?
  result         GameResult?
  participants   GameParticipant[]
  events         GameEvent[]
}

model GameParticipant {
  roomId String   @db.Uuid
  userId String   @db.Uuid
  seat   Int
  room   GameRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user   User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
  @@unique([roomId, seat])
  @@index([userId, roomId])
}

model GameEvent {
  id           String    @id @db.Uuid
  roomId       String    @db.Uuid
  stateVersion Int
  actorUserId  String?   @db.Uuid
  commandId    String?
  requestHash  String?
  source       String    @default("PLAYER")
  turnDeadline DateTime? @db.Timestamptz(3)
  command      Json
  snapshot     Json
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  room         GameRoom  @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actor        User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([roomId, stateVersion])
  @@unique([actorUserId, commandId])
}

model Lobby {
  id               String            @id @db.Uuid
  kind             String
  mode             String            @default("CLASSIC")
  rulesetVersion   String            @default("CLASSIC_NLHE_V1")
  capacity         Int
  hostId           String            @db.Uuid
  inviteHash       String?           @unique
  version          Int               @default(1)
  status           String            @default("OPEN")
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  seats            LobbySeat[]
  rulesConfig      Json?
  spadesAdmissions SpadesAdmission[]
  messages         TableMessage[]

  @@index([kind, mode, status, createdAt])
  @@index([kind, mode, rulesetVersion, status, createdAt], map: "Lobby_queue_rules_idx")
}

model LobbySeat {
  userId  String  @id @db.Uuid
  lobbyId String  @db.Uuid
  seat    Int
  ready   Boolean @default(false)
  lobby   Lobby   @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([lobbyId, seat])
}

model PlayChipAccount {
  id      String          @id @db.Uuid
  kind    String
  userId  String?         @unique @db.Uuid
  roomId  String?         @unique @db.Uuid
  balance BigInt          @default(0)
  user    User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  room    GameRoom?       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  entries PlayChipEntry[]
}

model PlayChipTransfer {
  id          String          @id @db.Uuid
  sourceKey   String          @unique
  requestHash String
  kind        String
  operatorId  String
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  entries     PlayChipEntry[]
}

model PlayChipEntry {
  transferId String           @db.Uuid
  accountId  String           @db.Uuid
  amount     BigInt
  transfer   PlayChipTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  account    PlayChipAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([transferId, accountId])
  @@index([accountId, transferId])
}

model GameAdmission {
  roomId         String            @id @db.Uuid
  lobbyId        String            @unique @db.Uuid
  buyIn          Int
  policyVersion  String
  policySnapshot Json
  room           GameRoom          @relation(fields: [roomId], references: [id], onDelete: Restrict)
  reservations   GameReservation[]
}

model GameReservation {
  roomId    String        @db.Uuid
  userId    String        @db.Uuid
  snapshot  Json
  admission GameAdmission @relation(fields: [roomId], references: [roomId], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
}

model GameResult {
  roomId         String   @id @db.Uuid
  stateVersion   Int
  rulesetVersion String
  allocation     Json
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  room           GameRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
}

model SpadesRoom {
  id             String              @id @db.Uuid
  rulesetVersion String
  stateVersion   Int                 @default(0)
  phase          String
  initial        Json
  snapshot       Json
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  seats          SpadesSeat[]
  events         SpadesEvent[]
  result         SpadesResult?
  admission      SpadesAdmission?    @relation("SpadesAdmissionRoom")
  rematches      SpadesAdmission[]   @relation("SpadesPreviousRoom")
  reservations   SpadesReservation[]
}

model SpadesSeat {
  roomId String     @db.Uuid
  userId String     @db.Uuid
  seat   Int
  room   SpadesRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user   User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
  @@unique([roomId, seat])
  @@index([userId, roomId])
}

model SpadesEvent {
  id           String     @id @db.Uuid
  roomId       String     @db.Uuid
  stateVersion Int
  actorUserId  String?    @db.Uuid
  commandId    String?
  requestHash  String?
  command      Json
  snapshot     Json
  receipt      Json?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  room         SpadesRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  actor        User?      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([roomId, stateVersion])
  @@unique([actorUserId, commandId])
}

model SpadesResult {
  roomId         String     @id @db.Uuid
  stateVersion   Int
  rulesetVersion String
  winner         Int
  teams          Json
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  room           SpadesRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
}

model SpadesAdmission {
  roomId         String      @id @db.Uuid
  lobbyId        String      @db.Uuid
  sequence       Int
  previousRoomId String?     @db.Uuid
  policySnapshot Json
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  room           SpadesRoom  @relation("SpadesAdmissionRoom", fields: [roomId], references: [id], onDelete: Restrict)
  previousRoom   SpadesRoom? @relation("SpadesPreviousRoom", fields: [previousRoomId], references: [id], onDelete: Restrict)
  lobby          Lobby       @relation(fields: [lobbyId], references: [id], onDelete: Restrict)

  @@unique([lobbyId, sequence])
  @@unique([lobbyId, previousRoomId])
}

model SpadesReservation {
  roomId String     @db.Uuid
  userId String     @db.Uuid
  items  Json
  room   SpadesRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user   User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([roomId, userId])
}

model TableMessage {
  id          String   @id @db.Uuid
  lobbyId     String   @db.Uuid
  actorUserId String   @db.Uuid
  seat        Int
  code        String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  lobby       Lobby    @relation(fields: [lobbyId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([lobbyId, createdAt])
  @@index([actorUserId, createdAt])
}

model FusionPreview {
  id          String     @id @db.Uuid
  ownerId     String     @db.Uuid
  childId     String     @unique @db.Uuid
  snapshot    Json
  fingerprint String
  expiresAt   DateTime   @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  job         FusionJob?
}

model FusionJob {
  id          String             @id @db.Uuid
  previewId   String             @unique @db.Uuid
  ownerId     String             @db.Uuid
  childId     String             @unique @db.Uuid
  receipt     Json
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  preview     FusionPreview      @relation(fields: [previewId], references: [id], onDelete: Restrict)
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  child       CardInstance       @relation(fields: [childId, ownerId], references: [id, ownerId], onDelete: Restrict)
  ingredients FusionIngredient[]

  @@unique([childId, ownerId])
}

model FusionIngredient {
  parentId        String       @id @db.Uuid
  jobId           String       @db.Uuid
  expectedVersion Int
  parent          CardInstance @relation(fields: [parentId], references: [id], onDelete: Restrict)
  job             FusionJob    @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([jobId])
}

model ProgressSource {
  key         String          @id
  kind        String
  sourceId    String          @db.Uuid
  policy      Json
  processedAt DateTime        @default(now()) @db.Timestamptz(3)
  events      ProgressEvent[]

  @@unique([kind, sourceId])
}

model ProgressEvent {
  id             String                @id @db.Uuid
  sourceKey      String
  userId         String                @db.Uuid
  kind           String
  occurredAt     DateTime              @db.Timestamptz(3)
  source         ProgressSource        @relation(fields: [sourceKey], references: [key], onDelete: Restrict)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  consumptions   ProgressConsumption[]
  accessibleFact AccessibleQuestFact?

  @@unique([sourceKey, userId, kind])
  @@index([userId, occurredAt, id])
}

model ProgressGoal {
  id                    String                      @id
  definition            Json
  policyHash            String
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  counters              ProgressCounter[]
  consumptions          ProgressConsumption[]
  awards                ProgressAward[]
  accessibleEnrollments AccessibleQuestEnrollment[]
}

model ProgressCounter {
  userId    String       @db.Uuid
  goalId    String
  windowKey String
  count     Int          @default(0)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  goal      ProgressGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@id([userId, goalId, windowKey])
}

model ProgressConsumption {
  eventId   String        @db.Uuid
  goalId    String
  windowKey String
  event     ProgressEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  goal      ProgressGoal  @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@id([eventId, goalId, windowKey])
}

model ProgressAward {
  id        String       @id @db.Uuid
  userId    String       @db.Uuid
  goalId    String
  windowKey String
  badge     String
  awardedAt DateTime     @default(now()) @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  goal      ProgressGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@unique([userId, goalId, windowKey])
}

model RestrictedAccount {
  id       String            @id @db.Uuid
  userId   String?           @db.Uuid
  currency String
  kind     String
  balance  BigInt            @default(0)
  user     User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries  RestrictedEntry[]

  @@unique([userId, currency])
}

model RestrictedTransfer {
  id                   String                     @id @db.Uuid
  sourceKey            String                     @unique
  requestHash          String
  currency             String
  purpose              String
  operatorId           String
  proofReference       String
  policyVersion        String
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  entries              RestrictedEntry[]
  accessibleCompletion AccessibleQuestCompletion?
}

model RestrictedEntry {
  transferId String             @db.Uuid
  accountId  String             @db.Uuid
  amount     BigInt
  transfer   RestrictedTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  account    RestrictedAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([transferId, accountId])
  @@index([accountId, transferId])
}

model AccessibleQuestEnrollment {
  id         String                     @id @db.Uuid
  userId     String                     @db.Uuid
  goalId     String
  windowKey  String
  definition Json
  policy     Json
  startedAt  DateTime                   @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime                   @db.Timestamptz(3)
  status     String                     @default("ACTIVE")
  version    Int                        @default(1)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  facts      AccessibleQuestFact[]
  completion AccessibleQuestCompletion?
  goal       ProgressGoal               @relation(fields: [goalId], references: [id], onDelete: Restrict)

  @@unique([userId, goalId, windowKey])
}

model AccessibleQuestFact {
  userId       String                    @db.Uuid
  sourceKey    String
  eventId      String                    @unique @db.Uuid
  enrollmentId String                    @db.Uuid
  user         User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  enrollment   AccessibleQuestEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  event        ProgressEvent             @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([userId, sourceKey])
}

model AccessibleQuestCompletion {
